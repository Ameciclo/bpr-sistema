{
  "name": "bpr-sistema",
  "version": "1.0.0",
  "description": "Sistema completo de monitoramento de bicicletas com WiFi scanning",
  "private": true,
  "workspaces": [
    "bot",
    "web"
  ],
  "scripts": {
    "setup": "npm install --workspaces && cd bot/functions && npm install",
    "dev:bot": "cd bot && npm run dev",
    "dev:web": "cd web && npm run dev",
    "build:bot": "cd bot/functions && npm run build",
    "check:functions": "cd bot/functions && npm run lint && npm run build",
    "build:web": "cd web && npm run build",
    "build:firmware:bici": "cd firmware/bici && pio run",
    "build:firmware:central": "cd firmware/central && pio run",
    "test": "npm run test --workspaces"
  },
  "keywords": [
    "iot",
    "esp8266",
    "esp32",
    "wifi-scanner",
    "firebase",
    "telegram-bot",
    "remix"
  ],
  "author": "BPR Team",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}